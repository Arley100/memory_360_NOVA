# Optional. Without a key, every page, the evidence viewer and search still work;
# only "Ask" and automatic update analysis need a model. Never commit .env.local.

# Option A: Anthropic (recommended)
ANTHROPIC_API_KEY=

# Per-task models (defaults shown). Live questions favor speed; the update analysis favors quality.
# LLM_MODEL_ASK=claude-sonnet-5-5
# LLM_MODEL_UPDATE=claude-opus-5-5
# LLM_MODEL_VISION=claude-sonnet-5-5
# Thinking effort per task: low | medium | high
# LLM_EFFORT_ASK=medium
# LLM_EFFORT_UPDATE=medium
# LLM_EFFORT_VISION=low
# Prompt cache lifetime: 5m (default) or 1h (use 1h on demo day so the cache stays warm)
# LLM_CACHE_TTL=1h

# Option B: any OpenAI-compatible provider (OpenAI, Mistral, Groq, local server...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model-name   (must support JSON output; vision needed to read new screenshots)

# ---- Hosted deployment (e.g. Vercel) ----
# Demo code required for Ask, update analysis, publish and reset. Leave empty locally (everything open).
# DEMO_CODE=
# Update storage outside the repository (the hosted filesystem is read-only). Added automatically when you
# connect an Upstash Redis store to the Vercel project; either naming works:
# UPSTASH_REDIS_REST_URL=      UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=             KV_REST_API_TOKEN=
