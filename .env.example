# Facultatif. Sans clé, toutes les pages, les preuves et la recherche restent accessibles.
# L’interrogation et l’analyse automatique des mises à jour nécessitent un modèle. Ne jamais versionner .env.local.

# Option A : Anthropic (recommandé)
ANTHROPIC_API_KEY=

# Modèles par tâche (valeurs par défaut). Les questions privilégient la rapidité ; les mises à jour, la qualité.
# LLM_MODEL_ASK=claude-sonnet-5-5
# LLM_MODEL_UPDATE=claude-opus-5-5
# LLM_MODEL_VISION=claude-sonnet-5-5
# Effort de raisonnement par tâche : low | medium | high
# LLM_EFFORT_ASK=medium
# LLM_EFFORT_UPDATE=medium
# LLM_EFFORT_VISION=low
# Durée du cache des consignes : 5m (par défaut) ou 1h (choisir 1h le jour de la démonstration)
# LLM_CACHE_TTL=1h

# Option B : fournisseur compatible avec OpenAI (OpenAI, Mistral, Groq, serveur local…)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=nom-du-modele   (sortie JSON requise ; vision nécessaire pour lire de nouvelles captures)

# ---- Déploiement hébergé (par exemple Vercel) ----
# Code de démonstration requis pour l’interrogation, l’analyse, la publication et la réinitialisation.
# Laisser vide localement pour un accès libre.
# DEMO_CODE=
# Stockage des mises à jour hors du dépôt (système de fichiers hébergé en lecture seule).
# Variables ajoutées automatiquement lors de la connexion d’Upstash Redis au projet Vercel ; les deux conventions fonctionnent :
# UPSTASH_REDIS_REST_URL=      UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=             KV_REST_API_TOKEN=
